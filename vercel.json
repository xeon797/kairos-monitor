{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/", "headers": [{ "key": "X-Kairos-Explanations", "value": "v1" }] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/today", "destination": "/index.html" },
    { "source": "/check", "destination": "/index.html" },
    { "source": "/trends", "destination": "/index.html" },
    { "source": "/mission", "destination": "/index.html" }
  ]
}
